# Database Configuration (SQLite)
# Path is relative to prisma/schema.prisma (e.g. file:./db/custom.db -> prisma/db/custom.db)
DATABASE_URL=file:./db/custom.db

# Dynamic database selector (the Prisma client currently supports PostgreSQL).
# Set both URLs to enable switching from Admin > Settings > Database connection.
# DATABASE_PROVIDER=neon
# NEON_DATABASE_URL=postgresql://...
# SUPABASE_DATABASE_URL=postgresql://...
# SQLITE_DATABASE_URL=file:./db/custom.db

# Application Configuration
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Security - CHANGE THESE IN PRODUCTION!
# IMPORTANT: Set this to your NextAuth secret token for authentication
# Generate a strong secret with: openssl rand -base64 32
# Windows PowerShell: -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 40 | ForEach-Object {[char]$_})
# 
# Example (DO NOT USE THIS IN PRODUCTION - GENERATE YOUR OWN):
# NEXTAUTH_SECRET=aB3cD5eF7gH9iJ1kL3mN5oP7qR9sT1uV3wX5yZ7aB9cD1eF3gH5iJ7kL9mN1oP3qR5sT7uV9wX1yZ3aB5cD7eF9gH1iJ3
# 
# For production, replace with your generated secret:
NEXTAUTH_SECRET=YOUR_GENERATED_SECRET_HERE_MIN_32_CHARACTERS
# NextAuth v5 uses AUTH_URL (deploy.sh will set this to your app port, e.g. 3006)
AUTH_URL=http://localhost:3006
# Legacy NextAuth v4 support (optional)
NEXTAUTH_URL=http://localhost:3006

# Legacy JWT settings (kept for backward compatibility)
JWT_SECRET=YOUR_GENERATED_SECRET_HERE_MIN_40_CHARACTERS
JWT_EXPIRES_IN=7d

# Public URLs - Update these to match your server's IP or domain
NEXT_PUBLIC_API_URL=http://localhost:3006
NEXT_PUBLIC_WS_URL=ws://localhost:3006

# Next.js Configuration
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_NAME=Tabadl Alkon CRM
# NEXT_PUBLIC_APP_VERSION is automatically set from package.json during build
# Or run ./setup-env.sh to generate .env with correct version

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3006
NEXT_PUBLIC_APP_DOMAIN=localhost:3006

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/app.log
VERBOSE_LOGGING=true
DEBUG=*

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000

# Security Headers
SECURE_HEADERS=true
CORS_ORIGIN=*

# Performance
NODE_OPTIONS=--max-old-space-size=1024

# Time (single source for server-rendered times: notifications, reminders, emails)
# IANA timezone, e.g. Asia/Karachi. All stored datetimes are UTC; this is for display text only.
APP_TIMEZONE=Asia/Karachi

# Docker Configuration
DOCKER_BUILDKIT=1
DOCKER_CLI_EXPERIMENTAL=enabled

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_INTERVAL=30

# Logging Configuration
LOG_FORMAT=json
LOG_TIMESTAMP=true

# WhatsApp Business API Configuration
# IMPORTANT: Set these to your actual WhatsApp Business API credentials
# These can also be configured in the admin panel (Admin → Settings → Email Settings → WhatsApp Notifications Configuration)
# If not set here, they must be configured in the admin panel for WhatsApp notifications to work
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token-here
WHATSAPP_API_VERSION=your-whatsapp-api-version-here
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id-here

# PWA Push Notifications (VAPID Keys)
# Generate keys with: pnpm run setup:vapid
# Example (DO NOT USE IN PRODUCTION - GENERATE YOUR OWN):
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=BCuvfB1ukWIN4xf7ipR-56DTL55gnCv2qwZLzm70qVFce-MKwoXG3RfymucpM1sSgQbZ1NDrEROu5Sco_RQraBw
# VAPID_PRIVATE_KEY=UfLiYNaOlnic3aKkYzdz6P-owFZis_vFvxJggvwwd9g
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here

# EdfaPay Payment Gateway
# Configure in Admin → Settings → Payment Gateway, or set here as fallback
EDFAPAY_MERCHANT_ID=
EDFAPAY_PASSWORD=
EDFAPAY_API_KEY=
EDFAPAY_ENVIRONMENT=sandbox
# Set to true in development to simulate payments without EdfaPay
ENABLE_MOCK_PAYMENT=false

# AI Chatbot (Ollama Cloud)
# Configure in Admin → Settings → AI Chatbot, or set here as fallback
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=qwen3:8b-cloud
OLLAMA_TEMPERATURE=0.7

# WhatsApp Document Base URL
# IMPORTANT: Set this to the base URL where documents (like company profile PDF) are accessible
# This URL is used for WhatsApp document links sent to clients
# Example: https://your-domain.com or http://your-server-ip:3006
# If not set, it will fallback to NEXT_PUBLIC_APP_URL
WHATSAPP_DOCUMENT_BASE_URL=https://tk.mylyra.app

